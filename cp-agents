#!/bin/zsh

set -euo pipefail

SOURCE_DIR="${CP_AGENTS_SOURCE:-$HOME/.claude/agents}"
TARGET_DIR="${CP_CODEX_AGENTS_TARGET:-$HOME/.codex/agents}"

if [[ ! -d "$SOURCE_DIR" ]]; then
  echo "Source agents directory not found: $SOURCE_DIR" >&2
  exit 0
fi

mkdir -p "$TARGET_DIR"

echo "Converting agents from $SOURCE_DIR"
echo "Target: $TARGET_DIR"

python3 - "$SOURCE_DIR" "$TARGET_DIR" <<'PY'
import re
import sys
from pathlib import Path

source_dir = Path(sys.argv[1])
target_dir = Path(sys.argv[2])

WRITE_TOOLS = {"Edit", "MultiEdit", "Write", "Bash"}


def parse_frontmatter(text, path):
    if not text.startswith("---\n"):
        raise ValueError(f"{path}: missing YAML frontmatter")

    end = text.find("\n---", 4)
    if end == -1:
        raise ValueError(f"{path}: unterminated YAML frontmatter")

    frontmatter = text[4:end]
    body_start = end + len("\n---")
    if body_start < len(text) and text[body_start:body_start + 1] == "\n":
        body_start += 1

    fields = {}
    for line in frontmatter.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        value = value.strip()
        if (
            (value.startswith('"') and value.endswith('"'))
            or (value.startswith("'") and value.endswith("'"))
        ):
            value = value[1:-1]
        fields[key.strip()] = value

    return fields, text[body_start:]


def parse_tools(value):
    if not value:
        return set()

    if value.startswith("[") and value.endswith("]"):
        value = value[1:-1]

    return {
        item.strip().strip('"').strip("'")
        for item in re.split(r",\s*", value)
        if item.strip()
    }


def toml_string(value):
    escaped = (
        value
        .replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\b", "\\b")
        .replace("\t", "\\t")
        .replace("\n", "\\n")
        .replace("\f", "\\f")
        .replace("\r", "\\r")
    )
    return f'"{escaped}"'


def write_agent(path):
    fields, body = parse_frontmatter(path.read_text(), path)
    name = fields.get("name", "").strip()
    description = fields.get("description", "").strip()

    if not name:
        raise ValueError(f"{path}: missing required frontmatter field: name")
    if not description:
        raise ValueError(f"{path}: missing required frontmatter field: description")

    tools = parse_tools(fields.get("tools", ""))
    sandbox_mode = "workspace-write" if tools & WRITE_TOOLS else "read-only"

    output = "\n".join([
        f"name = {toml_string(name)}",
        f"description = {toml_string(description)}",
        f"sandbox_mode = {toml_string(sandbox_mode)}",
        f"developer_instructions = {toml_string(body.rstrip())}",
        "",
    ])

    target_path = target_dir / f"{name}.toml"
    target_path.write_text(output)
    print(f"Wrote {target_path}")


for path in sorted(source_dir.glob("*.md")):
    if path.name.startswith("."):
        continue
    write_agent(path)
PY

echo "Done."
